// Alloy accepts only // comments. A # comment stops the agent from starting.
prometheus.scrape "local" {
  scrape_interval = "60s"
  targets = [
    {"__address__" = "127.0.0.1:9100", "job" = "node"},
    {"__address__" = "127.0.0.1:9101", "job" = "cadvisor"},
{% if observability_data %}
    {"__address__" = "127.0.0.1:9187", "job" = "postgres"},
    {"__address__" = "127.0.0.1:9121", "job" = "redis"},
{% endif %}
  ]
  forward_to = [prometheus.remote_write.mon.receiver]
}

prometheus.remote_write "mon" {
  endpoint {
    url = "http://{{ observability_mon_host }}:9090/api/v1/write"
  }
  external_labels = {"project" = "{{ shipyard_project }}", "env" = "{{ shipyard_env }}", "host" = "{{ inventory_hostname }}"}
}

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Kamal names containers <service>-<role>-<destination>-<version>, so use its service label for a stable name.
discovery.relabel "containers" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_service"]
    regex         = "(.+)"
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.mon.receiver]
}

loki.write "mon" {
  endpoint {
    url = "http://{{ observability_mon_host }}:3100/loki/api/v1/push"
  }
  external_labels = {"project" = "{{ shipyard_project }}", "env" = "{{ shipyard_env }}", "host" = "{{ inventory_hostname }}"}
}
{% if observability_app %}

// Apps send OTLP to host.docker.internal, which is the Docker bridge address.
otelcol.receiver.otlp "apps" {
  grpc {
    endpoint = "{{ observability_bridge_ip }}:4317"
  }
  http {
    endpoint = "{{ observability_bridge_ip }}:4318"
  }
  output {
    traces  = [otelcol.exporter.otlp.mon.input]
    metrics = [otelcol.exporter.prometheus.apps.input]
  }
}

otelcol.exporter.otlp "mon" {
  client {
    endpoint = "{{ observability_mon_host }}:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "apps" {
  forward_to = [prometheus.remote_write.mon.receiver]
}
{% endif %}
