#!/usr/bin/env bash
# Usage: pg-restore.sh <db> [object-name|latest] [target-db]. Restores into <db> unless a target is given.
set -euo pipefail

db="${1:?usage: pg-restore.sh <db> [object-name|latest] [target-db]}"
target="${3:-$db}"
dir="{{ shipyard_dir }}/backups"
declare -A prefixes=({% for b in backups_databases %}[{{ b.db }}]="{{ b.prefix }}" {% endfor %})
prefix="${prefixes[$db]:?$db isn't in backups_databases}"

aws() {
  docker run --rm --env-file "$dir/r2.env" -v "$dir/work:/work" {{ backups_aws_cli_image }} \
    --endpoint-url "{{ backups_r2_endpoint }}" "$@"
}

mkdir -p "$dir/work"
pick="${2:-latest}"
[ "$pick" = latest ] && pick=""
name="${pick:-$(aws s3 ls "s3://{{ backups_r2_bucket }}/$prefix/" | sort | tail -1 | awk '{print $4}')}"
[ -n "$name" ] || { echo "No dumps under $prefix"; exit 1; }
aws s3 cp "s3://{{ backups_r2_bucket }}/$prefix/$name" "/work/$name" --only-show-errors
docker exec -i postgres pg_restore -U {{ data_postgres_user }} -d "$target" --clean --if-exists < "$dir/work/$name"
rm -f "$dir/work/$name"
echo "Restored $prefix/$name into $target"
